
@{
    Layout = null;
}

<!DOCTYPE html>
<html>

@await Component.InvokeAsync("_UILayoutHeadComponentPartial")

<body class="sub_page">

    @await Component.InvokeAsync("_UILayoutNavbarComponentPartial")
    </div>


    <section class="food_section layout_padding">
        <div class="container">
            <div class="container mt-2">
                <div class="row">
                    <div class="col-12">
                        <h3 class="text-center mb-4">Lavinia Anlık Mesajlaşma</h3>
                    </div>
                </div>
                <div class="row p-1">
                    <div class="col-2">Kullanıcı Adınız: </div>
                    <div class="col-5">
                        <input type="text" class="form-control" id="userinput"/>
                    </div>
                </div>
                <div class="row p-1">
                    <div class="col-2">Mesajınız: </div>
                    <div class="col-5">
                        <input type="text" class="form-control" id="messageinput" />
                    </div>
                </div>
                <div class="row p-1">
                    <div class="col-2"></div>
                    <div class="col-3">
                        <input type="button" class="btn btn-primary" id="sendButton" value="Mesaj Gönder"/>
                    </div>
                </div>
                <div class="row p-1">
                    <div class="col-12">
                        <hr />
                    </div>
                </div>
                <div class="row p-1">
                    <div class="col-12">
                        <ul class="list-group" id="messagelist"></ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @await Component.InvokeAsync("_UILayoutFooterComponentPartial")

    @await Component.InvokeAsync("_UILayoutScriptComponentPartial")

</body>

</html>