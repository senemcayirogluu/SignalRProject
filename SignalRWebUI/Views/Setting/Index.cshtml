@model UserEditDto

@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Profil Ayarları</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<div class="card-header">
							<div class="card-title">Profil Bilgileri Güncelleme</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="name">Adınızı giriniz:</label>
								<input type="text" class="form-control" asp-for="Name" id="name">
							</div>
							<div class="form-group">
								<label for="surname">Soyadınızı giriniz:</label>
								<input type="text" class="form-control" asp-for="Surname" id="surname">
							</div>
							<div class="form-group">
								<label for="username">Kullanıcı adınızı giriniz:</label>
								<input type="text" class="form-control" asp-for="Username" id="username">
							</div>
							<div class="form-group">
								<label for="mail">Email giriniz:</label>
								<input type="email" class="form-control" asp-for="Mail" id="mail">
							</div>
							<div class="form-group">
								<label for="password">Şifrenizi giriniz:</label>
								<input type="password" class="form-control" asp-for="Password" id="password">
							</div>
							<div class="form-group">
								<label for="confirmpassword">Şifrenizi tekrar giriniz:</label>
								<input type="password" class="form-control" asp-for="ConfirmPassword" id="confirmpassword">
							</div>
							<div class="card-action">
								<button class="btn btn-primary">Bilgileri Güncelle</button>
							</div>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

