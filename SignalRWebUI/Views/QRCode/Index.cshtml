@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/AdminLayout/Index.cshtml";
}

<style>
	.qr-section {
		background: #fffbfbc2;
		border-radius: 12px;
		box-shadow: 0 2px 12px rgba(0,0,0,0.08);
		padding: 2rem;
		margin-bottom: 2rem;
		margin-left: 2rem;
	}

	.qr-title {
		font-weight: 600;
		color: #2c3e50;
		margin-bottom: 1.5rem;
		letter-spacing: 1px;
	}

	.form-group label {
		font-weight: 500;
		color: #34495e;
	}

	.btn {
		min-width: 140px;
	}

	.qr-image {
		display: block;
		margin: 1.5rem auto 0 auto;
		border-radius: 8px;
		box-shadow: 0 1px 8px rgba(44,62,80,0.12);
	}
</style>

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">QR Kod Oluşturma & Çözme</h4>
		<div class="row justify-content-center">
			<div class="col-md-5 qr-section">
				<h5 class="mb-4 text-warning text-center">QR Kod Oluştur</h5>
				<form method="post" asp-action="Index" asp-controller="QRCode">
					<div class="form-group mb-3">
						<label>QR Kod:</label>
						<input type="text" name="value" placeholder="Metin giriniz..." />
					</div>
				     <div class="text-center">
						<button type="submit" class="btn btn-warning">Oluştur</button>
					</div>
				</form>

				@if (ViewBag.QRCodeImage != null)
				{
					<div class="mt-3">
						<img src="@ViewBag.QRCodeImage" alt="" width="300" height="300" class="qr-image" />
					</div>
				}
			</div>

			<div class="col-md-5 qr-section">
				<h5 class="mb-4 text-success text-center">QR Kod Çöz</h5>
				<form method="post" asp-action="DecodeQRCode" enctype="multipart/form-data">
					<div class="form-group mb-3">
						<label>QR Kod:</label>
						<input type="file" name="file" class="form-control-file" />
					</div>
					<div class="text-center">
						<button type="submit" class="btn btn-success">Çöz</button>
					</div>
				</form>

				@if (ViewBag.DecodedText != null)
				{
					<div class="alert alert-info mt-4 text-center ml-0">
						Çözülen Metin: <strong>@ViewBag.DecodedText</strong>
					</div>
				}
			</div>
		</div>
	</div>
</div>