@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/AdminLayout/Index.cshtml";
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>



<div class="content">
	<div class="container-fluid">

		<script type="text/javascript">
			$(document).ready(() => {

				var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:7122/SignalRHub").build();
				$("#connstatus").text(connection.state);

				connection.start().then(() => {
					$("#connstatus").text(connection.state);

					setInterval(() => {
					   connection.invoke("SendProgressBar");
					}, 1000);

				}).catch((err) => { console.log(err) });

				connection.on("ReceiveTotalMoneyCaseAmount", (value) => {
				$("#totalmoneycaseamount").text(value);
				});

				connection.on("ReceiveActiveOrderCount", (value2) => {
				$("#activeordercount").text(value2);
				});

				connection.on("ReceiveMenuTableCount", (value3) => {
				$("#menutablecount").text(value3);
				});

				connection.on("ReceiveMenuTableCount", (value4) => {
				$("#totalMenuTableCountProgress").empty();
					$("#totalMenuTableCountProgress").append(`
					<div class="d-flex justify-content-between mb-1">
				    <span class="text-muted">Toplam Masa Sayısı</span>
				    <span class="text-muted fw-bold">${value4}</span>
			        </div>
			        <div class="progress mb-2" style="height: 7px;">
					<div class="progress-bar bg-success" role="progressbar" style="width: ${value4}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${value4}%"></div>
			        </div>
					`);
				});

				connection.on("ReceiveProductPriceAverage", (value5) => {
				$("#productpriceaverageprogress").empty();
					$("#productpriceaverageprogress").append(`
					<div class="d-flex justify-content-between mb-1">
					<span class="text-muted">Ortalama Ürün Fiyatı</span>
					<span class="text-muted fw-bold">${value5}₺</span>
					</div>
					<div class="progress mb-2" style="height: 7px;">
					<div class="progress-bar bg-info" role="progressbar" style="width: ${value5}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${value5}%"></div>
					</div>
					`);
				});

				connection.on("ReceiveAvgProductPriceByHamburger", (value6) => {
				$("#AvgProductPriceByHamburgerProgress").empty();
					$("#AvgProductPriceByHamburgerProgress").append(`
					<div class="d-flex justify-content-between mb-1">
					<span class="text-muted">Ortalama Hamburger Fiyatı</span>
					<span class="text-muted fw-bold">${value6}₺</span>
					</div>
					<div class="progress mb-2" style="height: 7px;">
					<div class="progress-bar bg-primary" role="progressbar" style="width: ${value6}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${value6}%"></div>
					</div>
					`);
				});

				connection.on("ReceiveProductCountByCategoryNameDrink", (value7) => {
				$("#ProductCountByCategoryNameDrinkProgress").empty();
					$("#ProductCountByCategoryNameDrinkProgress").append(`
					<div class="d-flex justify-content-between mb-1">
					<span class="text-muted">İçecek Sayısı</span>
					<span class="text-muted fw-bold">${value7}</span>
					</div>
					<div class="progress mb-2" style="height: 7px;">
					<div class="progress-bar bg-warning" role="progressbar" style="width: ${value7}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${value7}%"></div>
					</div>
					`);
				});

				connection.on("ReceiveTotalOrderCount", (value8) => {
				$("#TotalOrderCountProgress").empty();
					$("#TotalOrderCountProgress").append(`
					<div class="d-flex justify-content-between mb-1">
					<span class="text-muted">Toplam Sipariş Sayısı</span>
					<span class="text-muted fw-bold">${value8}</span>
					</div>
					<div class="progress mb-2" style="height: 7px;">
					<div class="progress-bar bg-secondary" role="progressbar" style="width: ${value8}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${value8}%"></div>
					</div>
					`);
				});

				connection.on("ReceiveLastOrderPrice", (value9) => {
				$("#LastOrderPriceProgress").empty();
					$("#LastOrderPriceProgress").append(`
					<div class="d-flex justify-content-between mb-1">
					<span class="text-muted">Son Sipariş Fiyatı</span>
					<span class="text-muted fw-bold">${value9}₺</span>
					</div>
					<div class="progress mb-2" style="height: 7px;">
					<div class="progress-bar bg-danger" role="progressbar" style="width: ${value9}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${value9}%"></div>
					</div>
					`);
				});

				connection.on("ReceiveProductPriceBySteakBurger", (value10) => {
				$("#ProductPriceBySteakBurgerProgress").empty();
					$("#ProductPriceBySteakBurgerProgress").append(`
					<div class="d-flex justify-content-between mb-1">
					<span class="text-muted">Steak Burger Fiyatı</span>
					<span class="text-muted fw-bold">${value10}₺</span>
					</div>
					<div class="progress mb-2" style="height: 7px;">
					<div class="progress-bar bg-dark" role="progressbar" style="width: ${value10}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${value10}%"></div>
					</div>
					`);
				});

				connection.on("ReceiveAvgProductPriceByDrink", (value11) => {
				$("#AvgProductPriceByDrinkProgress").empty();
					$("#AvgProductPriceByDrinkProgress").append(`
					<div class="d-flex justify-content-between mb-1">
					<span class="text-muted">Ortalama İçecek Fiyatı</span>
					<span class="text-muted fw-bold">${value11}₺</span>
					</div>
					<div class="progress mb-2" style="height: 7px;">
					<div class="progress-bar bg-light" role="progressbar" style="width: ${value11}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${value11}%"></div>
					</div>
					`);
				});
				
			})
		</script>
		

		<h4 class="page-title">Admin İstatistikleri ve Durumları</h4>
		<div class="row row-card-no-pd">
			<div class="col-md-4">
				<div class="card">
					<div class="card-body">
						<p class="fw-bold mt-1">Kasadaki Toplam Tutar</p>
						<h4 id="totalmoneycaseamount"><b></b></h4>
						<hr />
						<p class="fw-bold mt-1">Toplam Ürün Fiyatları</p>
						<h4 id="">2853.80₺</h4>
						<hr />
						<p class="fw-bold mt-1">Ortalama Ürün Fiyatları</p>
						<h4 id="">10.0₺</h4>
						<hr />
						<p class="fw-bold mt-1">Son Sipariş Fiyatı</p>
						<h4 id="">85.0₺</h4>
						<hr />
						<a href="/Order/CreateOrder" class="btn btn-primary btn-full text-left mt-3 mb-3"><i class="la la-plus"></i> Yeni Sipariş</a>
					</div>
					<div class="card-footer">
						<ul class="nav">
							<li class="nav-item"><a class="btn btn-default btn-link" href="/Order/Index/"><i class="la la-history"></i> Siparişler</a></li>
							<li class="nav-item ml-auto"><a class="btn btn-default btn-link" href="/ProgressBars/Index/"><i class="la la-refresh"></i> Sayfayı Yenile</a></li>
						</ul>
					</div>
				</div>
			</div>
			<div class="col-md-5">
				<div class="card">
					<div class="card-body">
						<div class="progress-card" id="totalMenuTableCountProgress"></div>
						<div class="progress-card" id="productpriceaverageprogress"></div>
						<div class="progress-card" id="AvgProductPriceByHamburgerProgress"></div>
						<div class="progress-card" id="ProductCountByCategoryNameDrinkProgress"></div>
						<div class="progress-card" id="TotalOrderCountProgress"></div>
						<div class="progress-card" id="LastOrderPriceProgress"></div>
						<div class="progress-card" id="ProductPriceBySteakBurgerProgress"></div>
						<div class="progress-card" id="AvgProductPriceByDrinkProgress"></div>
					</div>
				</div>
			</div>
			<div class="col-md-3">
				<div class="card card-stats">
					<div class="card-body">
						<p class="fw-bold mt-1">Anlık İstatistikler</p>
						<div class="row">
							<div class="col-5">
								<div class="icon-big text-center icon-warning">
									<i class="la la-pie-chart text-warning"></i>
								</div>
							</div>
							<div class="col-7 d-flex align-items-center">
								<div class="numbers">
									<p class="card-category">Aktif Sipariş</p>
									<h4 class="card-title" id="activeordercount"></h4>
								</div>
							</div>
						</div>
						<hr />
						<div class="row">
							<div class="col-5">
								<div class="icon-big text-center">
									<i class="la la-tablet text-primary"></i>
								</div>
							</div>
							<div class="col-7 d-flex align-items-center">
								<div class="numbers">
									<p class="card-category">Masa Sayısı</p>
									<h4 class="card-title" id="menutablecount"></h4>
								</div>
							</div>
						</div>
						<hr />
						<div class="row">
							<div class="col-5">
								<div class="icon-big text-center">
									<i class="la la-certificate text-danger"></i>
								</div>
							</div>
							<div class="col-7 d-flex align-items-center">
								<div class="numbers">
									<p class="card-category">Kategori Sayısı</p>
									<h4 class="card-title" id="">10</h4>
								</div>
							</div>
						</div>
						<hr />
						<div class="row">
							<div class="col-5">
								<div class="icon-big text-center">
									<i class="la la-beer text-success"></i>
								</div>
							</div>
							<div class="col-7 d-flex align-items-center">
								<div class="numbers">
									<p class="card-category">Ürün Sayısı</p>
									<h4 class="card-title" id="">10</h4>
								</div>
							</div>
						</div>
						<hr />
						<div class="row">
							<div class="col-5">
								<div class="icon-big text-center">
									<i class="la la-book text-info"></i>
								</div>
							</div>
							<div class="col-7 d-flex align-items-center">
								<div class="numbers">
									<p class="card-category">Rezervasyon Sayısı</p>
									<h4 class="card-title" id="">10</h4>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

